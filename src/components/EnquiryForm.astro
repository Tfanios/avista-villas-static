---
import { getProperties } from "../lib/cms";

const properties = await getProperties();
---

<form class="enquiry-form" data-enquiry-form novalidate>
  <div class="hp" aria-hidden="true">
    <label for="bot_field">Leave this field empty</label>
    <input type="text" id="bot_field" name="bot_field" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label for="name">Full name</label>
    <input
      class="control"
      type="text"
      id="name"
      name="fullName"
      autocomplete="name"
      required
    />
  </div>

  <div class="field-row">
    <div class="field">
      <label for="email">Email</label>
      <input class="control" type="email" id="email" name="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="phone">Phone <span class="opt">(optional)</span></label>
      <input class="control" type="tel" id="phone" name="phone" autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="property">Preferred villa</label>
    <select class="control" id="property" name="property">
      <option value="either">Either villa / not sure yet</option>
      {properties.map((property: any) => <option value={property.slug}>{property.name}</option>)}
    </select>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="arrival">Arrival</label>
      <input class="control" type="date" id="arrival" name="arrival" />
    </div>
    <div class="field">
      <label for="departure">Departure</label>
      <input class="control" type="date" id="departure" name="departure" />
    </div>
  </div>

  <div class="field">
    <label for="guests">Group size</label>
    <input
      class="control"
      type="number"
      id="guests"
      name="guests"
      min="1"
      max="16"
      inputmode="numeric"
      placeholder="e.g. 8"
    />
  </div>

  <div class="field">
    <label for="message">Your stay</label>
    <textarea
      class="control"
      id="message"
      name="message"
      rows="5"
      placeholder="Tell us a little about your group and what you are looking for."
      required
    ></textarea>
  </div>

  <p class="form-note">
    We use your details only to reply to this enquiry. No marketing, no sharing.
  </p>

  <button class="btn solid" type="submit">Send enquiry</button>

  <p class="form-status" role="status" aria-live="polite" tabindex="-1" hidden>
    Thank you, your enquiry is on its way. We will reply by email shortly.
  </p>
</form>

<script>
  import emailjs from "@emailjs/browser";

  const form = document.querySelector<HTMLFormElement>("[data-enquiry-form]");

  if (form) {
    const status = form.querySelector<HTMLElement>(".form-status");
    const button = form.querySelector<HTMLButtonElement>("[type='submit']");

    const setStatus = (message: string) => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
      status.focus();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      if (data.get("bot_field")) return;
      if (!form.reportValidity()) return;

      const values = {
        fullName: String(data.get("fullName") || ""),
        email: String(data.get("email") || ""),
        message: String(data.get("message") || ""),
        bot_field: String(data.get("bot_field") || "")
      };

      const templateParams = {
        name: values.fullName,
        message: values.message,
        email: values.email
      };

      if (button) {
        button.disabled = true;
        button.textContent = "Sending…";
      }

      try {
        await emailjs.send(
          "service_zoi63wc",
          "template_x9zscxf",
          {
            message: templateParams.message,
            user_name: templateParams.name,
            user_email: templateParams.email
          },
          "user_CXLxkqNSVUkCA2DfAu57B"
        );

        window.location.assign("/thank-you");
      } catch (error) {
        console.error(error);
        setStatus("We could not send your enquiry. Please try again.");
        if (button) {
          button.disabled = false;
          button.textContent = "Send enquiry";
        }
      }
    });
  }

