---
import { type MediaInput } from "../lib/media";

interface MapLocation {
  latitude: number;
  longitude: number;
  zoom?: number;
  label?: string;
  directionsQuery?: string;
  staticPreview?: MediaInput;
}

interface Props {
  titleHtml: string;
  body: string;
  title: string;
  location: MapLocation;
}

const { titleHtml, body, title, location } = Astro.props;
const zoom = location.zoom ?? 13;
const hasCoordinates =
  Number.isFinite(location.latitude) && Number.isFinite(location.longitude);
const embedSrc = `https://www.google.com/maps?q=${location.latitude},${location.longitude}&z=${zoom}&output=embed`;
const dest = location.directionsQuery
  ? encodeURIComponent(location.directionsQuery)
  : `${location.latitude},${location.longitude}`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${dest}`;
const hasHeader = !!(titleHtml || body);
---

{
  hasCoordinates && (
    <section class="section bg-2" id="map">
      <div class="wrap">
        {hasHeader && (
          <div
            class="gallery-head"
            style="margin-bottom: clamp(28px, 4vw, 52px); padding-inline: 0"
          >
            {titleHtml && (
              <div class="reveal">
                <h2 class="h-section" set:html={titleHtml} />
              </div>
            )}
            {body && <p class="body-muted reveal d1">{body}</p>}
          </div>
        )}

        <div class="map-embed reveal d1">
          <iframe
            class="map-iframe"
            src={embedSrc}
            title={title || location.label || "Location map"}
            loading="eager"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
          <a class="map-directions" href={directions} target="_blank" rel="noopener">
            Get directions
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M7 17L17 7M9 7h8v8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )
}
