---
interface Props {
  reviews: any[];
}

const { reviews } = Astro.props;

// CMS `source` keys mapped to the platform names guests recognise.
const SOURCE_NAMES: Record<string, string> = {
  booking: "Booking.com",
  airbnb: "Airbnb",
  google: "Google"
};
const sourceName = (key?: string) => (key ? SOURCE_NAMES[key.toLowerCase()] ?? key : "");
---

{
  reviews.length > 0 && (
    <section class="section" id="reviews">
      <div class="carousel-wrap reveal d1">
        <div class="carousel reviews" aria-label="Guest reviews">
          {reviews.map((review) => (
            <div class="card review-card">
              <div class="rev-head">
                {review.source && <span class="rev-logo">{sourceName(review.source)}</span>}
                {review.score != null && (
                  <span class="rev-score">
                    <span class="vh">Rated </span>{review.score}<span class="vh"> out of 10</span>
                  </span>
                )}
              </div>
              <p class="rev-quote">"{review.quote}"</p>
              <div class="rev-by">
                <span class="rev-name">{review.authorName}</span>
                <span class="rev-meta">
                  {[review.authorLocation, review.date].filter(Boolean).join(" · ")}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
