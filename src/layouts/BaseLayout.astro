---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { getFooter, getSiteSettings } from "../lib/cms";
import { type MediaInput } from "../lib/media";
import { optimizeImage, socialImage } from "../lib/optimized-image";
import { serializeSchema, siteSchema } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  // The above-the-fold hero image (LCP) — preloaded so it paints sooner.
  preloadImage?: MediaInput;
  preloadMobileImage?: MediaInput;
  // Link-preview image; falls back to the site default.
  image?: MediaInput;
  noindex?: boolean;
  // Page-level schema.org nodes, added to the sitewide ones.
  schema?: unknown[];
}

const {
  title,
  description,
  currentPath = "",
  preloadImage,
  preloadMobileImage,
  image,
  noindex = false,
  schema = []
} = Astro.props;
const preload = await optimizeImage(preloadImage);
const mobilePreload = await optimizeImage(preloadMobileImage);
const siteSettings = await getSiteSettings();
const footer = await getFooter();

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
// Staging and workers.dev copies must not compete with the real site in search.
const isProductionHost = Astro.url.hostname === site.hostname;
const shareImage = await socialImage(image ?? siteSettings.socialImage);
const shareImageUrl = shareImage ? new URL(shareImage.src, site).href : undefined;
const schemaJson = serializeSchema([...siteSchema(site, siteSettings), ...schema]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex || !isProductionHost
      ? <meta name="robots" content="noindex" />
      : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Avista Villas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImageUrl && (
      <>
        <meta property="og:image" content={shareImageUrl} />
        <meta property="og:image:width" content={shareImage?.width} />
        <meta property="og:image:height" content={shareImage?.height} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2B362F" />
    <script type="application/ld+json" set:html={schemaJson} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          media={mobilePreload ? "(min-width: 768px)" : undefined}
          href={preload.src}
          imagesrcset={preload.srcset}
          imagesizes={preload.srcset ? "100vw" : undefined}
          fetchpriority="high"
        />
      )
    }
    {mobilePreload && (
      <link rel="preload" as="image" media="(max-width: 767px)"
        href={mobilePreload.src} imagesrcset={mobilePreload.srcset}
        imagesizes="100vw" fetchpriority="high" />
    )}
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&family=Marcellus&family=Mulish:wght@300;400;500&family=Tenor+Sans&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/avista.css" />
    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
        @media (max-width: 880px) {
          .nav {
            position: absolute;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 16px;
            color: #fff;
          }
          .nav-links,
          .nav-links.right {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
          }
          .brand {
            order: -1;
            width: 100%;
          }
          .nav-menu-btn {
            display: none;
          }
        }
      </style>
    </noscript>
  </head>
  <body
    data-weather-latitude={siteSettings.weather.latitude}
    data-weather-longitude={siteSettings.weather.longitude}
    data-weather-label={siteSettings.weather.label}
  >
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav currentPath={currentPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer.show && <Footer />}
    <slot name="overlays" />
    <script is:inline src="/avista.js"></script>
    <slot name="after-scripts" />
  </body>
</html>
