---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Avista Villas"
  description="This page could not be found."
  noindex
>
  <section class="section wrap">
    <div class="reveal in" style="max-width: 48rem; margin: 5rem auto; text-align: center;">
      <p class="eyebrow">Page not found</p>
      <h1 class="h-section">This page has moved or no longer exists</h1>
      <a class="btn solid" href="/" style="margin-top: 2rem;">Return home</a>
    </div>
  </section>
</BaseLayout>
