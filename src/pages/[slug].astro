---
import OptimizedImage from "../components/OptimizedImage.astro";
import AmenityGrid from "../components/AmenityGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CrossLink from "../components/CrossLink.astro";
import Cta from "../components/Cta.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import Lightbox from "../components/Lightbox.astro";
import LocationBlock from "../components/LocationBlock.astro";
import MapEmbed from "../components/MapEmbed.astro";
import Reviews from "../components/Reviews.astro";
import VideoModal from "../components/VideoModal.astro";
import { getProperties, getPropertyReviews } from "../lib/cms";
import { propertyLocations } from "../lib/property-locations";

const { slug } = Astro.params;
const property = (await getProperties()).find((item) => item.slug === slug);
if (!property) return new Response(null, { status: 404 });

const { sections } = property;
const reviews = sections.reviews ? await getPropertyReviews(property.slug) : [];
const showDetail =
  sections.spaces &&
  !!(property.detail.titleHtml || property.detail.body || property.detail.image);
const showAmenities = sections.amenities && property.amenities.length > 0;
const mapLocation = propertyLocations[property.slug];
---

<BaseLayout
  title={property.seo.title}
  description={property.seo.description}
  currentPath={property.slug}
  preloadImage={sections.hero ? property.hero.imageDesktop : undefined}
  preloadMobileImage={sections.hero ? property.hero.imageMobile : undefined}
>
  {sections.hero && <Hero hero={{ ...property.hero, playOnMobile: true }} />}

  {
    (showDetail || showAmenities) && (
      <section class="section bg-2" id="spaces">
        <div class="wrap">
          {showDetail && (
            <div class="loc">
              <div class="reveal">
                {property.detail.titleHtml && (
                  <h2 class="h-section" set:html={property.detail.titleHtml} />
                )}
                {property.detail.body && (
                  <p class="body-muted" style="margin-top: 1.6rem">
                    {property.detail.body}
                  </p>
                )}
              </div>
              {property.detail.image && (
                <div class="loc-figure reveal d1">
                  <OptimizedImage src={property.detail.image} alt={property.detail.imageAlt} />
                </div>
              )}
            </div>
          )}

          {showAmenities && <AmenityGrid amenities={property.amenities} />}
        </div>
      </section>
    )
  }

  {sections.gallery && (
    <Gallery
      titleHtml={property.galleryTitleHtml}
      note={property.galleryNote}
      hint={property.galleryHint}
      items={property.gallery}
    />
  )}

  {sections.reviews && <Reviews reviews={reviews} />}

  {sections.map && mapLocation && (
    <MapEmbed
      titleHtml={`Find ${mapLocation.label}`}
      body=""
      title={`${mapLocation.label} location`}
      location={mapLocation}
    />
  )}

  {sections.location && (
    <LocationBlock
      titleHtml={property.location.titleHtml}
      body={property.location.body}
      image={property.location.image}
      imageAlt={property.location.imageAlt}
      facts={property.location.facts}
      deep
    />
  )}

  {sections.cross_link && property.crossLink && (
    <section class="section wrap">
      <CrossLink link={property.crossLink} flip={property.order % 2 === 0} />
    </section>
  )}

  {sections.cta && <Cta cta={property.cta} />}

  <Fragment slot="overlays">
    {sections.gallery && property.gallery.length > 0 && <Lightbox label={property.name} />}
    {property.filmUrl && <VideoModal src={property.filmUrl} label={property.name} />}
  </Fragment>
</BaseLayout>
