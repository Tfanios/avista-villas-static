---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Hero from "../components/Hero.astro";
import MapEmbed from "../components/MapEmbed.astro";
import { getContactPage, getSiteSettings } from "../lib/cms";
import { breadcrumbSchema } from "../lib/seo";

const contactPage = await getContactPage();
const siteSettings = await getSiteSettings();
const { sections } = contactPage;
---

<BaseLayout
  title={contactPage.seo.title}
  description={contactPage.seo.description}
  image={contactPage.seo.image}
  schema={[breadcrumbSchema(Astro.site!, "Enquire", "/contact/")]}
  currentPath="contact"
  preloadImage={sections.hero ? contactPage.hero.imageDesktop : undefined}
  preloadMobileImage={sections.hero ? contactPage.hero.imageMobile : undefined}
>
  {sections.hero && <Hero hero={contactPage.hero} />}

  {sections.enquiry && (
  <section class="section wrap">
    <div class="loc enquiry">
      <div class="reveal">
        {contactPage.intro.titleHtml && (
          <h2 class="h-section" set:html={contactPage.intro.titleHtml} />
        )}
        {contactPage.intro.body && (
          <p class="body-muted" style="margin-top: 1.6rem">
            {contactPage.intro.body}
          </p>
        )}

        {
          (siteSettings.contactEmail ||
            siteSettings.contactPhones.length > 0 ||
            siteSettings.addressHtml) && (
            <dl class="enquiry-contacts">
              {siteSettings.contactEmail && (
                <div class="enquiry-contact">
                  <dt>Email</dt>
                  <dd>
                    <a href={`mailto:${siteSettings.contactEmail}`}>
                      {siteSettings.contactEmail}
                    </a>
                  </dd>
                </div>
              )}
              {siteSettings.contactPhones.length > 0 && (
                <div class="enquiry-contact">
                  <dt>Telephone</dt>
                  <dd>
                    {siteSettings.contactPhones.map((phone: string) => (
                      <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}>{phone}</a>
                    ))}
                  </dd>
                </div>
              )}
              {siteSettings.addressHtml && (
                <div class="enquiry-contact">
                  <dt>Estate</dt>
                  <dd set:html={siteSettings.addressHtml} />
                </div>
              )}
            </dl>
          )
        }
      </div>

      <div class="reveal d1">
        <EnquiryForm />
      </div>
    </div>
  </section>
  )}

  {sections.map && (
    <MapEmbed
      titleHtml={contactPage.map.titleHtml}
      body={contactPage.map.body}
      location={contactPage.map.location}
      title={contactPage.map.title}
    />
  )}
</BaseLayout>
