---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank you | Avista Villas"
  description="Thank you for contacting Avista Villas."
  currentPath="contact"
>
  <section class="section wrap">
    <div class="reveal in" style="max-width: 48rem; margin: 5rem auto; text-align: center;">
      <p class="eyebrow">Enquiry received</p>
      <h1 class="h-section">Thank you</h1>
      <p class="body-muted" style="margin-top: 1.5rem;">
        Your enquiry is on its way. We will reply by email shortly.
      </p>
      <a class="btn solid" href="/" style="margin-top: 2rem;">Return home</a>
    </div>
  </section>
</BaseLayout>
