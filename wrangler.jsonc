{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Separate from the live static Worker (avista-villas-static).
  "name": "avista-emdash",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Read at runtime. The allowedOrigins option in astro.config.mjs never reaches the
  // Worker, so passkeys from staging would be rejected without this.
  "vars": {
    "EMDASH_ALLOWED_ORIGINS": "https://staging.avistavillas.com"
  },
  // workers.dev would be a second public door to the setup wizard.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "avistavillas.com", "custom_domain": true },
    { "pattern": "staging.avistavillas.com", "custom_domain": true },
    { "pattern": "www.avistavillas.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avista-emdash",
      "database_id": "3d9c2564-f973-4cf6-bfb7-9fbd82e72490"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "avista-emdash-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Publishes scheduled entries; see the scheduled handler in src/worker.ts.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
